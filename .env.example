# ==============================================================================
# GraphRAG Banking Compliance & Risk Intelligence System - Environment Variables
# Copy this file to .env and configure your local or cloud settings:
# cp .env.example .env
# ==============================================================================

# Neo4j Database Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here
NEO4J_DATABASE=neo4j

# Pipeline Ingestion Settings
MAX_CHUNK_CHARS=1200
CHUNK_OVERLAP_CHARS=200
BATCH_SIZE=250

# Optional Future LLM / Embedding API Keys (Phase 6 / Future Answer Generation)
# Leave blank during initial ingestion and graph preparation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
